{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurogeo.example/schema/phase4-external-evidence-1.json",
  "title": "neurogeo 6.0 Phase 4 external evidence receipt",
  "type": "object",
  "required": [
    "schema", "status", "package_version", "candidate", "operators",
    "cohorts", "benchmarks", "external_reproductions", "open_release",
    "manuscript", "external_reviews"
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "operator": {
      "type": "object",
      "required": [
        "operator_id", "family", "source_space", "target_space",
        "direction", "version", "sha256", "source_uri", "doi", "license",
        "legal_redistribution", "metric", "expected_coverage",
        "qc_procedure", "qc_pass", "reviewer", "review_record"
      ],
      "properties": {
        "operator_id": {"$ref": "#/$defs/text"},
        "family": {
          "enum": ["fsaverage", "fslr", "mni", "cifti-density", "atlas"]
        },
        "source_space": {"$ref": "#/$defs/text"},
        "target_space": {"$ref": "#/$defs/text"},
        "direction": {"$ref": "#/$defs/text"},
        "version": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "source_uri": {"$ref": "#/$defs/text"},
        "doi": {"$ref": "#/$defs/text"},
        "license": {"$ref": "#/$defs/text"},
        "legal_redistribution": {"type": "boolean"},
        "metric": {"$ref": "#/$defs/text"},
        "expected_coverage": {"$ref": "#/$defs/text"},
        "qc_procedure": {"$ref": "#/$defs/text"},
        "qc_pass": {"type": "boolean"},
        "reviewer": {"$ref": "#/$defs/text"},
        "review_record": {"$ref": "#/$defs/text"}
      }
    },
    "cohort": {
      "type": "object",
      "required": [
        "cohort_id", "role", "site_id", "independence_rule",
        "participants", "data_terms_uri", "ethics_record",
        "public_reconstruction", "preregistration_uri",
        "endpoint_plan_sha256", "analysis_commit", "completed",
        "positive_null_failed_reported", "reviewer", "review_record"
      ],
      "properties": {
        "cohort_id": {"$ref": "#/$defs/text"},
        "role": {"enum": ["discovery", "replication"]},
        "site_id": {"$ref": "#/$defs/text"},
        "independence_rule": {"$ref": "#/$defs/text"},
        "participants": {"type": "integer", "minimum": 1},
        "data_terms_uri": {"$ref": "#/$defs/text"},
        "ethics_record": {"$ref": "#/$defs/text"},
        "public_reconstruction": {"type": "boolean"},
        "preregistration_uri": {"$ref": "#/$defs/text"},
        "endpoint_plan_sha256": {"$ref": "#/$defs/sha256"},
        "analysis_commit": {"$ref": "#/$defs/commit"},
        "completed": {"type": "boolean"},
        "positive_null_failed_reported": {"type": "boolean"},
        "reviewer": {"$ref": "#/$defs/text"},
        "review_record": {"$ref": "#/$defs/text"}
      }
    },
    "benchmark": {
      "type": "object",
      "required": [
        "benchmark_id", "category", "estimand", "matched_inputs",
        "reference", "analysis_commit", "result_uri", "source_data_sha256",
        "completed", "all_attempts_reported", "reviewer", "review_record"
      ],
      "properties": {
        "benchmark_id": {"$ref": "#/$defs/text"},
        "category": {
          "enum": [
            "area-weighting", "metric", "atlas-ensemble", "spatial-null",
            "uncertainty", "guard", "competitor"
          ]
        },
        "estimand": {"$ref": "#/$defs/text"},
        "matched_inputs": {"$ref": "#/$defs/text"},
        "reference": {"$ref": "#/$defs/text"},
        "analysis_commit": {"$ref": "#/$defs/commit"},
        "result_uri": {"$ref": "#/$defs/text"},
        "source_data_sha256": {"$ref": "#/$defs/sha256"},
        "completed": {"type": "boolean"},
        "all_attempts_reported": {"type": "boolean"},
        "reviewer": {"$ref": "#/$defs/text"},
        "review_record": {"$ref": "#/$defs/text"}
      }
    },
    "reproduction": {
      "type": "object",
      "required": [
        "reproduction_id", "laboratory", "independent_of_development",
        "public_materials_only", "figure_id", "release_tag", "source_commit",
        "expected_source_data_sha256", "observed_source_data_sha256",
        "reproduced", "deviations_uri", "resolution_uri", "reviewer",
        "review_record"
      ],
      "properties": {
        "reproduction_id": {"$ref": "#/$defs/text"},
        "laboratory": {"$ref": "#/$defs/text"},
        "independent_of_development": {"type": "boolean"},
        "public_materials_only": {"type": "boolean"},
        "figure_id": {"$ref": "#/$defs/text"},
        "release_tag": {"type": "string", "pattern": "^v6[.]0[.]0-rc[0-9]+$"},
        "source_commit": {"$ref": "#/$defs/commit"},
        "expected_source_data_sha256": {"$ref": "#/$defs/sha256"},
        "observed_source_data_sha256": {"$ref": "#/$defs/sha256"},
        "reproduced": {"type": "boolean"},
        "deviations_uri": {"$ref": "#/$defs/text"},
        "resolution_uri": {"$ref": "#/$defs/text"},
        "reviewer": {"$ref": "#/$defs/text"},
        "review_record": {"$ref": "#/$defs/text"}
      }
    },
    "external_review": {
      "type": "object",
      "required": [
        "reviewer_id", "independent", "novelty", "broad_interest",
        "technical_validity", "independent_evidence", "recommendation",
        "review_record"
      ],
      "properties": {
        "reviewer_id": {"$ref": "#/$defs/text"},
        "independent": {"type": "boolean"},
        "novelty": {"$ref": "#/$defs/text"},
        "broad_interest": {"$ref": "#/$defs/text"},
        "technical_validity": {"$ref": "#/$defs/text"},
        "independent_evidence": {"$ref": "#/$defs/text"},
        "recommendation": {"enum": ["go", "no-go", "revise"]},
        "review_record": {"$ref": "#/$defs/text"}
      }
    }
  },
  "properties": {
    "schema": {"const": "neurogeo/phase4-external-evidence/1"},
    "status": {"enum": ["awaiting-external-evidence", "complete"]},
    "package_version": {"const": "6.0.0"},
    "candidate": {
      "type": "object",
      "required": ["release_tag", "source_commit", "p0_attestation_sha256"],
      "properties": {
        "release_tag": {
          "type": ["string", "null"],
          "pattern": "^v6[.]0[.]0-rc[0-9]+$"
        },
        "source_commit": {
          "anyOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]
        },
        "p0_attestation_sha256": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    },
    "operators": {"type": "array", "items": {"$ref": "#/$defs/operator"}},
    "cohorts": {"type": "array", "items": {"$ref": "#/$defs/cohort"}},
    "benchmarks": {"type": "array", "items": {"$ref": "#/$defs/benchmark"}},
    "external_reproductions": {
      "type": "array", "items": {"$ref": "#/$defs/reproduction"}
    },
    "open_release": {
      "type": "object",
      "required": [
        "code_doi", "data_doi", "operators_doi", "source_data_doi",
        "environment_uri", "environment_sha256", "rebuild_command",
        "rebuild_log_uri", "all_figures_rebuilt", "licenses_complete",
        "orcids_complete", "contributions_complete", "reviewer", "review_record"
      ]
    },
    "manuscript": {
      "type": "object",
      "required": [
        "artifact_uri", "sha256", "claims_consistent",
        "equations_and_statistics_checked", "limitations_complete",
        "api_status_consistent", "availability_statements_complete",
        "references_and_source_data_complete", "reviewer", "review_record"
      ]
    },
    "external_reviews": {
      "type": "array", "minItems": 0, "maxItems": 3,
      "items": {"$ref": "#/$defs/external_review"}
    }
  }
}
